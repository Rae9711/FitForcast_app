# FitForecast Frontend Configuration
# Copy this file to .env and fill in your actual values

# API Backend URL
# Leave unset (or use /api) to go through the Vite/nginx same-origin proxy.
# For a remote API (e.g. production), set the absolute backend origin:
# VITE_API_BASE_URL=https://your-api-domain.com
VITE_API_BASE_URL=/api

# Default User ID (for MVP development without auth)
VITE_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

# Feature Flags
VITE_ENABLE_MOCK_DATA=false
